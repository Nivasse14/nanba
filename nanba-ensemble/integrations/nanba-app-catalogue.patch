@@ -0,0 +1,7 @@
+// The public assistant receives the reference; the advertiser's phone remains private.
+function whatsappCatalogueContact(item = {}) {
+  const reference = String(item.remoteId || item.id || '');
+  if (!/^wa_listing_[a-f0-9]{36}$/.test(reference)) return '';
+  return 'https://wa.me/12694043536?text=' + encodeURIComponent('Je souhaite être mis en relation pour l’annonce Nanba ' + reference);
+}
+module.exports = { whatsappCatalogueContact };
