index 0000000..b8657b2
--- /dev/null
+++ b/apps/api/src/whatsapp-catalogue.js
@@ -0,0 +1,113 @@
+'use strict';
+
+const { createHash, createHmac, timingSafeEqual } = require('node:crypto');
+const hash = value => createHash('sha256').update(value).digest('hex');
+const fail = (message, status = 400) => Object.assign(new Error(message), { status, code: message });
+const clean = (value, max = 180) => String(value || '').trim().slice(0, max);
+const SHARDS = 16;
+
+function verifyCatalogueRequest(headers, body, secret, clock = Date.now()) {
+  if (!secret || secret.length < 32) throw fail('WHATSAPP_CATALOGUE_NOT_CONFIGURED', 503);
+  const timestamp = String(headers['x-nanba-timestamp'] || '');
+  const signature = String(headers['x-nanba-signature'] || '');
+  if (!/^\d{13}$/.test(timestamp) || Math.abs(clock - Number(timestamp)) > 120000 || !/^[a-f0-9]{64}$/.test(signature)) throw fail('WHATSAPP_CATALOGUE_UNAUTHORIZED', 401);
+  const expected = createHmac('sha256', secret).update(timestamp + '\n' + JSON.stringify(body)).digest('hex');
+  if (!timingSafeEqual(Buffer.from(expected), Buffer.from(signature))) throw fail('WHATSAPP_CATALOGUE_UNAUTHORIZED', 401);
+  if (!/^[a-f0-9]{64}$/.test(body.actor || '')) throw fail('WHATSAPP_ACTOR_INVALID');
+  return 'wa_' + body.actor;
+}
+
+function prepareWhatsAppListing(body, ownerId, clock = Date.now()) {
+  const a = body.listing || {};
+  if (body.consent !== true) throw fail('PUBLICATION_CONSENT_REQUIRED');
+  if (!['housing', 'jobs', 'market', 'services'].includes(a.target)) throw fail('LISTING_TARGET_REQUIRED');
+  if (!['offer', 'request'].includes(a.intent)) throw fail('LISTING_INTENT_REQUIRED');
+  if (!clean(a.title) || clean(a.description, 1800).length < 10 || !clean(a.location)) throw fail('LISTING_DESCRIPTION_AND_LOCATION_REQUIRED');
+  if (!/^[a-zA-Z0-9_-]{10,120}$/.test(body.requestId || '')) throw fail('IDEMPOTENCY_KEY_REQUIRED');
+  // Phone numbers, email addresses and precise addresses are not public contact fields.
+  const redact = value => clean(value, 1800).replace(/\+?\d[\d ().-]{7,}\d/g, '[coordonnées privées]').replace(/[\w.+-]+@[\w.-]+\.[a-z]{2,}/gi, '[courriel privé]');
+  const amount = a.price === null || a.price === undefined ? null : Number(a.price);
+  if (amount !== null && (!Number.isFinite(amount) || amount < 0 || amount > 10000000)) throw fail('LISTING_PRICE_INVALID');
+  const date = new Date(clock).toISOString();
+  const propertyTypes = (Array.isArray(a.propertyTypes) ? a.propertyTypes : []).filter(x => ['private-room', 'shared-room', 'studio', 't1', 't2', 't3', 't4', 't5-plus'].includes(x));
+  if (a.target === 'housing' && a.intent === 'offer' && (amount === null || !propertyTypes.length)) throw fail('HOUSING_RENT_AND_TYPE_REQUIRED');
+  const id = 'wa_listing_' + hash(ownerId + ':' + body.requestId).slice(0, 36);
+  return {
+    id, ownerId, ownerName: clean(body.alias || 'Membre Nanba', 60), source: 'whatsapp',
+    target: a.target, intent: a.intent, categoryKey: a.target + '_' + a.intent,
+    title: redact(a.title).slice(0, 180), description: redact(a.description), location: redact(a.location).slice(0, 180),
+    sourceLocale: ['fr', 'en', 'ta'].includes(a.locale) ? a.locale : 'fr',
+    price: amount, dateOrPrice: amount === null ? '' : amount + ' €',
+    region: clean(a.region), department: clean(a.department, 3),
+    jobContract: clean(a.jobContract, 40), jobField: clean(a.jobField, 100),
+    housingDetails: a.target === 'housing' ? { rent: amount, propertyTypes, locations: [{ name: clean(a.location), label: clean(a.location), type: 'city' }], availabilityMode: a.availableFrom ? 'date' : 'now', availabilityDate: clean(a.availableFrom, 10) } : {},
+    marketListingKind: a.target === 'market' ? 'item' : '',
+    attachments: [], contactPublic: '', contactMasked: 'Mise en relation via Nanba', contactEmailPublic: '',
+    website: '', status: 'moderation', createdAt: date, updatedAt: date, publishedAt: '',
+    expiresAt: new Date(clock + 30 * 86400000).toISOString(),
+  };
+}
+
+function createWhatsAppCatalogue({ store, getState, persist, clock = Date.now }) {
+  let cached = null, cachedAt = 0, localQueue = Promise.resolve();
+  const shard = id => parseInt(hash(id).slice(0, 2), 16) % SHARDS;
+  const readPayload = result => {
+    if (!result.found) return { items: {} };
+    if (!result.record?.payload?.items || typeof result.record.payload.items !== 'object' || Array.isArray(result.record.payload.items)) throw fail('CATALOGUE_STORAGE_INVALID', 503);
+    return result.record.payload;
+  };
+  async function list(force = false) {
+    if (!store) return structuredClone(Object.values(getState().whatsappCatalogue || {}));
+    if (!force && cached && clock() - cachedAt < 5000) return structuredClone(cached);
+    const items = [];
+    for (let offset = 0; offset < SHARDS; offset += 4) {
+      const results = await Promise.all(Array.from({ length: 4 }, (_, i) => store.read('catalogue:' + (offset + i))));
+      for (const result of results) items.push(...Object.values(readPayload(result).items));
+    }
+    cached = items; cachedAt = clock();
+    return structuredClone(items);
+  }
+  async function change(id, transform) {
+    if (!store) {
+      const operation = localQueue.then(async () => {
+        const previous = getState().whatsappCatalogue || {};
+        const item = transform(previous[id]);
+        getState().whatsappCatalogue = { ...previous, [id]: item };
+        try { await persist(); } catch (error) { getState().whatsappCatalogue = previous; throw error; }
+        return structuredClone(item);
+      });
+      localQueue = operation.catch(() => {}); return operation;
+    }
+    const key = 'catalogue:' + shard(id);
+    for (let attempt = 0; attempt < 4; attempt++) {
+      const before = await store.read(key);
+      const merge = payload => {
+        const items = { ...(payload?.items || {}) };
+        items[id] = transform(items[id]);
+        // Keep tombstones for 90 days so late retries cannot resurrect a withdrawn listing.
+        for (const [key, item] of Object.entries(items)) if (clock() - Date.parse(item.updatedAt) > 90 * 86400000 && Date.parse(item.expiresAt) < clock()) delete items[key];
+        if (Buffer.byteLength(JSON.stringify(items)) > 750000) throw fail('CATALOGUE_SHARD_FULL', 503);
+        return { items };
+      };
+      const versionAt = new Date(Math.max(clock(), (Date.parse(before.record?.versionAt) || 0) + 1)).toISOString();
+      const result = await store.write(key, merge(readPayload(before)), { versionAt, mergePayload: merge });
+      if (result.written) { cached = null; return result.payload.items[id]; }
+    }
+    throw fail('CATALOGUE_SAVE_CONFLICT', 503);
+  }
+  async function create(item) { return change(item.id, current => current || item); }
+  async function update(id, ownerId, changes, moderator = false) {
+    return change(id, current => {
+      if (!current) throw fail('LISTING_NOT_FOUND', 404);
+      if (!moderator && current.ownerId !== ownerId) throw fail('LISTING_OWNER_REQUIRED', 403);
+      if (current.deletedAt) { if (changes.deletedAt) return current; throw fail('LISTING_NOT_FOUND', 404); }
+      if (changes.expectedUpdatedAt && current.updatedAt !== changes.expectedUpdatedAt) throw fail('LISTING_CHANGED_RELOAD', 409);
+      const { expectedUpdatedAt, ...patch } = changes;
+      return { ...current, ...patch, id: current.id, ownerId: current.ownerId, source: 'whatsapp', updatedAt: new Date(clock()).toISOString() };
+    });
+  }
+  const active = item => !item.deletedAt && Date.parse(item.expiresAt) > clock();
+  return { list, create, update, active };
+}
+
+module.exports = { createWhatsAppCatalogue, prepareWhatsAppListing, verifyCatalogueRequest };
