+const assert = require('node:assert/strict');
+const { test } = require('node:test');
+const { createHmac } = require('node:crypto');
+const { mkdtempSync, writeFileSync, rmSync } = require('node:fs');
+const { tmpdir } = require('node:os');
+const path = require('node:path');
+const { Readable, Writable } = require('node:stream');
+Object.assign(process.env, { NANBA_DATA_BACKEND: 'json', NANBA_DISABLE_OPENAI: 'true', NANBA_DISABLE_RATE_LIMIT: 'true', NANBA_NEWS_DISABLE_REMOTE: 'true', PUSH_AUTO_DISPATCH: 'false', NANBA_CINEMA_TV_BACKGROUND_REFRESH: 'false', NANBA_WHATSAPP_CATALOGUE_SECRET: 'catalogue-test-secret-'.repeat(3) });
+const { createServer } = require('../apps/api/src/server');
+const { createMemoryVersionedJsonStore } = require('../apps/api/src/versioned-json-store');
+const { createWhatsAppCatalogue, prepareWhatsAppListing, verifyCatalogueRequest } = require('../apps/api/src/whatsapp-catalogue');
+
+function request(server, url, { body, token, method, signed = false } = {}) {
+  return new Promise((resolve, reject) => {
+    const raw = body ? JSON.stringify(body) : '';
+    const timestamp = String(Date.now());
+    const req = new Readable({ read() { this.push(raw || null); if (raw) this.push(null); } });
+    req.method = method || (body ? 'POST' : 'GET'); req.url = url;
+    req.headers = { 'content-type': 'application/json', ...(token ? { authorization: 'Bearer ' + token } : {}), ...(signed ? { 'x-nanba-timestamp': timestamp, 'x-nanba-signature': createHmac('sha256', process.env.NANBA_WHATSAPP_CATALOGUE_SECRET).update(timestamp + '\n' + raw).digest('hex') } : {}) };
+    const res = new Writable({ write(chunk, encoding, cb) { cb(); } });
+    let status = 200;
+    res.writeHead = s => { status = s; };
+    res.end = raw => resolve({ status, body: raw ? JSON.parse(raw.toString()) : null });
+    Promise.resolve(server.listeners('request')[0](req, res)).catch(reject);
+  });
+}
+const payload = (n = 1, actor = 'a'.repeat(64)) => ({ action: 'publish', actor, consent: true, requestId: 'test-request-' + n, alias: 'Membre test', listing: { target: 'housing', intent: 'offer', title: 'Chambre disponible à Sevran', description: 'Chambre meublée disponible dès maintenant.', location: 'Sevran', price: 500, propertyTypes: ['private-room'] } });
+
+test('signed WhatsApp submission -> principal moderation -> public catalogue on another instance -> withdrawal', async () => {
+  const dir = mkdtempSync(path.join(tmpdir(), 'nanba-catalogue-'));
+  const store = createMemoryVersionedJsonStore();
+  const servers = ['a', 'b'].map(name => {
+    const dataFile = path.join(dir, name + '.json');
+    writeFileSync(dataFile, JSON.stringify({ users: [{ id: 'moderator', userId: 'moderator', role: 'admin' }], sessions: [{ id: 'moderator-session', accessToken: 'moderator-token', userId: 'moderator', role: 'admin', displayName: 'Admin' }] }));
+    return createServer({ dataFile, whatsappCatalogueStore: store });
+  });
+  try {
+    const endpoint = '/integrations/whatsapp/catalogue';
+    assert.equal((await request(servers[0], endpoint, { body: payload() })).status, 401);
+    assert.equal((await request(servers[0], endpoint, { body: { ...payload(), consent: false }, signed: true })).status, 400);
+    const created = await request(servers[0], endpoint, { body: payload(), signed: true });
+    assert.equal(created.status, 200); assert.equal(created.body.status, 'moderation');
+    const id = created.body.id;
+    assert.equal((await request(servers[0], endpoint, { body: payload(), signed: true })).body.id, id);
+    let list = await request(servers[1], '/listings?target=housing');
+    assert(!list.body.some(x => x.id === id), 'pending never publicly visible');
+    const queue = await request(servers[1], '/admin/moderation-queue', { token: 'moderator-token' });
+    assert.equal(queue.status, 200); assert(queue.body.listings.some(x => x.id === id));
+    const approved = await request(servers[1], '/moderation/listings/' + id, { token: 'moderator-token', body: { decision: 'approved' } });
+    assert.equal(approved.status, 200); assert.equal(approved.body.status, 'published');
+    // Force a canonical refresh on the first server through the private owner read.
+    await request(servers[0], endpoint, { body: { actor: payload().actor, action: 'mine' }, signed: true });
+    list = await request(servers[0], '/listings?target=housing');
+    assert(list.body.some(x => x.id === id && x.price === 500));
+    assert.equal((await request(servers[0], endpoint, { body: { actor: 'b'.repeat(64), action: 'remove', reference: id }, signed: true })).status, 403);
+    const removed = await request(servers[0], endpoint, { body: { actor: payload().actor, action: 'remove', reference: id }, signed: true });
+    assert.equal(removed.body.status, 'withdrawn');
+    assert.equal((await request(servers[0], endpoint, { body: { actor: payload().actor, action: 'remove', reference: id }, signed: true })).status, 200);
+    assert(!(await request(servers[0], '/listings?target=housing')).body.some(x => x.id === id));
+    assert.equal((await request(servers[0], endpoint, { body: payload(), signed: true })).body.status, 'withdrawn', 'retries cannot resurrect withdrawn publication');
+  } finally { for (const server of servers) server.emit('close'); rmSync(dir, {recursive: true, force: true}); }
+});
+
+test('durable concurrent publications, owner scope, expiry, tamper rejection and storage failure', async () => {
+  const store = createMemoryVersionedJsonStore();
+  const a = createWhatsAppCatalogue({ store, getState: () => ({}), persist: async () => {} });
+  const b = createWhatsAppCatalogue({ store, getState: () => ({}), persist: async () => {} });
+  const items = Array.from({length: 40}, (_, i) => prepareWhatsAppListing(payload(i), 'wa_' + 'a'.repeat(64)));
+  await Promise.all(items.map((item, i) => (i % 2 ? a : b).create(item)));
+  assert.equal((await a.list(true)).length, 40);
+  await assert.rejects(a.update(items[0].id, 'another-owner', {status:'published'}), { status: 403 });
+  assert(!a.active({...items[0], expiresAt: '2000-01-01'}));
+  const clock = Date.now(), body = payload();
+  const headers = {'x-nanba-timestamp':String(clock), 'x-nanba-signature':createHmac('sha256',process.env.NANBA_WHATSAPP_CATALOGUE_SECRET).update(clock+'\n'+JSON.stringify(body)).digest('hex')};
+  assert.equal(verifyCatalogueRequest(headers,body,process.env.NANBA_WHATSAPP_CATALOGUE_SECRET,clock),'wa_'+body.actor);
+  assert.throws(()=>verifyCatalogueRequest(headers,{...body,actor:'b'.repeat(64)},process.env.NANBA_WHATSAPP_CATALOGUE_SECRET,clock),{status:401});
+  assert.throws(()=>verifyCatalogueRequest(headers,body,process.env.NANBA_WHATSAPP_CATALOGUE_SECRET,clock+121000),{status:401});
+  const localState = {};
+  const failing = createWhatsAppCatalogue({getState:()=>localState,persist:async()=>{throw Error('disk unavailable');}});
+  await assert.rejects(failing.create(items[0])); assert.deepEqual(await failing.list(),[]);
+});
