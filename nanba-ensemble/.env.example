NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=data/development.db
APP_ORIGIN=http://localhost:3000
WHATSAPP_MODE=simulated
WAHA_URL=http://127.0.0.1:3001
WAHA_SESSION=nanba-pilot
WAHA_ENGINE=WEBJS
WAHA_API_KEY=
WAHA_WEBHOOK_SECRET=
# Must be explicitly set before any real transport is enabled.
ALLOW_REAL_SEND=false
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_DAILY_CALLS=20
AI_MAX_OUTPUT_TOKENS=600
RETENTION_DAYS=90
# Required outside development. 64 hexadecimal characters, generated privately.
IDENTITY_ENCRYPTION_KEY=
# Twilio conversational assistant (independent from the WAHA community transport).
# Alternatively configure encrypted credentials using the private /twilio page.
TWILIO_AI_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe

# Outbound synthetic voice; default used by the assistant
OPENAI_VOICE_MODEL=gpt-realtime-2.1-mini

# Mark accepted inbound messages as read and show typing while processing
TWILIO_PRESENCE_ENABLED=true

# Shared server-to-server HMAC secret (generate outside Git; same value on Cloud Run and Render).
NANBA_WHATSAPP_CATALOGUE_SECRET=
