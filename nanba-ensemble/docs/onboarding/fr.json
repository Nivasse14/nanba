{
  "friendly_name": "nanba_onboarding_flow_fr_v3",
  "language": "fr",
  "types": {
    "twilio/flows": {
      "body": "Choisis tes préférences dans le formulaire WhatsApp, ou écris QUESTIONS ICI. Un récapitulatif sera demandé avant enregistrement.",
      "subtitle": "Tes choix seront confirmés dans la conversation.",
      "type": "SURVEY",
      "button_text": "Personnaliser",
      "pages": [
        {
          "id": "replies",
          "next_page_id": "interests",
          "title": "Mes réponses",
          "layout": [
            {
              "type": "SINGLE_SELECT",
              "name": "language",
              "label": "Dans quelle langue ?",
              "text": "Facultatif. PASSER garde le réglage actuel.",
              "required": false,
              "options": "[{\"id\":\"fr\",\"title\":\"Français\"},{\"id\":\"en\",\"title\":\"English\"},{\"id\":\"ta\",\"title\":\"தமிழ்\"},{\"id\":\"tanglish\",\"title\":\"Tanglish\"}]"
            },
            {
              "type": "SINGLE_SELECT",
              "name": "replyMode",
              "label": "Format de réponse",
              "text": "Facultatif. PASSER garde le réglage actuel.",
              "required": false,
              "options": "[{\"id\":\"text\",\"title\":\"Texte\"},{\"id\":\"audio\",\"title\":\"Audio (voix IA)\"},{\"id\":\"auto\",\"title\":\"Comme mes messages\"}]"
            }
          ]
        },
        {
          "id": "interests",
          "next_page_id": "preferences",
          "title": "Mes intérêts",
          "layout": [
            {
              "type": "MULTIPLE_SELECT",
              "name": "interests",
              "label": "Sujets (4 maximum)",
              "text": "Facultatif. PASSER garde le réglage actuel.",
              "required": false,
              "options": "[{\"id\":\"housing\",\"title\":\"Logement\"},{\"id\":\"jobs\",\"title\":\"Emploi\"},{\"id\":\"services\",\"title\":\"Démarches et services\"},{\"id\":\"news\",\"title\":\"Actualités\"},{\"id\":\"events\",\"title\":\"Sorties\"},{\"id\":\"cinema\",\"title\":\"Cinéma\"},{\"id\":\"cuisine\",\"title\":\"Cuisine\"},{\"id\":\"image\",\"title\":\"Images\"},{\"id\":\"horoscope\",\"title\":\"Horoscope\"}]"
            },
            {
              "type": "SHORT_TEXT",
              "name": "city",
              "label": "Ta ville ?",
              "text": "Facultatif. PASSER garde le réglage actuel.",
              "required": false,
              "input_type": "TEXT"
            }
          ]
        },
        {
          "id": "preferences",
          "next_page_id": null,
          "title": "Mon assistant",
          "layout": [
            {
              "type": "SINGLE_SELECT",
              "name": "tone",
              "label": "Ton de l’assistant",
              "text": "Facultatif. PASSER garde le réglage actuel.",
              "required": false,
              "options": "[{\"id\":\"warm\",\"title\":\"Chaleureux\"},{\"id\":\"direct\",\"title\":\"Direct\"},{\"id\":\"calm\",\"title\":\"Posé\"}]"
            },
            {
              "type": "SINGLE_SELECT",
              "name": "length",
              "label": "Niveau de détail",
              "text": "Facultatif. PASSER garde le réglage actuel.",
              "required": false,
              "options": "[{\"id\":\"short\",\"title\":\"Court\"},{\"id\":\"detailed\",\"title\":\"Détaillé\"}]"
            },
            {
              "type": "SINGLE_SELECT",
              "name": "notifications",
              "label": "Envoi automatique ?",
              "text": "Facultatif. PASSER garde le réglage actuel.",
              "required": false,
              "options": "[{\"id\":\"none\",\"title\":\"Aucune sélection automatique\"},{\"id\":\"morning\",\"title\":\"Une sélection le matin\"},{\"id\":\"evening\",\"title\":\"Une sélection le soir\"},{\"id\":\"keep\",\"title\":\"Garder mon programme actuel\"}]"
            },
            {
              "type": "TEXT_BODY",
              "text": "Envoi sur confirmation. Fuseau par défaut : Europe/Paris."
            },
            {
              "type": "MULTIPLE_SELECT",
              "name": "dailyTopics",
              "label": "Thèmes (4 maximum)",
              "text": "Facultatif. PASSER garde le réglage actuel.",
              "required": false,
              "options": "[{\"id\":\"news\",\"title\":\"Actualités\"},{\"id\":\"events\",\"title\":\"Sorties\"},{\"id\":\"cinema\",\"title\":\"Cinéma\"},{\"id\":\"cuisine\",\"title\":\"Cuisine\"},{\"id\":\"image\",\"title\":\"Images\"}]"
            },
            {
              "type": "SHORT_TEXT",
              "name": "at",
              "label": "Heure (HH:MM)",
              "text": "Exemple : 08:30. Heures calmes : 22h–7h par défaut.",
              "required": false,
              "input_type": "TEXT"
            },
            {
              "type": "SHORT_TEXT",
              "name": "timezone",
              "label": "Fuseau horaire",
              "text": "Europe/Paris · Asia/Kolkata · ou autre fuseau IANA.",
              "required": false,
              "input_type": "TEXT"
            }
          ]
        }
      ]
    }
  }
}
